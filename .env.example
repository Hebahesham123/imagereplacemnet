# Your store's .myshopify.com domain
SHOP=naguibselim.myshopify.com

# Admin API access token from a custom app (starts with shpat_)
# Scopes needed: read_content, read_themes, write_themes, read_files, write_files
ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: theme to edit (numeric id). Leave empty to edit the live theme.
# Tip: put a duplicate/preview theme id here first to test safely.
THEME_ID=

# Optional: public domain used for image thumbnails
STOREFRONT_DOMAIN=naguibselim.com

# Optional: password for the dashboard (any username works)
APP_PASSWORD=

PORT=3000
